{
  "expo": {
    "name": "TimeGate",
    "slug": "timegate-kisok-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "timegate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timegate.kiosk",
      "infoPlist": {
        "NSCameraUsageDescription": "Autorisez TimeGate a utiliser la camera pour la verification faciale."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD23F"
      },
      "package": "com.timegate.kiosk",
      "permissions": [
        "NFC",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-face-detector-camera",
        {
          "cameraPermission": "Autorisez TimeGate a utiliser la camera pour la verification faciale."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbb18368-e42d-4a15-ab57-591f0ae98ec3"
      }
    },
    "owner": "kysr_styve"
  }
}
