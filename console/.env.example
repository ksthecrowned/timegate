# Console Plateforme — variables d'environnement
# TimeGate API (NestJS, port 4001, prefix /api/v1)
NEXT_PUBLIC_TIMEGATE_API_URL=http://localhost:4001/api/v1

# NextAuth — secret stable (ne pas changer sans vider les cookies de session)
# Générer : openssl rand -base64 32
AUTH_SECRET=
# NEXTAUTH_SECRET=
