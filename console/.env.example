# Console Plateforme — variables pour Vercel (Project Settings → Environment Variables)
#
# Déploiement Vercel : Root Directory = console

# API NestJS (obligatoire) — ex. https://api.example.com/api/v1
NEXT_PUBLIC_TIMEGATE_API_URL=

# NextAuth / Auth.js (obligatoire) — openssl rand -base64 32
AUTH_SECRET=
# NEXTAUTH_SECRET=

# URL publique de la console (recommandé en prod) — ex. https://console.example.com
# AUTH_URL=

# Session (optionnel)
# AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
# AUTH_SESSION_MAX_AGE_SECONDS=28800
# AUTH_REFRESH_ENABLED=false
