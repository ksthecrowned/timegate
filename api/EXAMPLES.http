### TimeGate API examples (VS Code REST Client / similar)
### Dev: bun install && bun run prisma:migrate && bun run prisma:seed && bun run start:dev
@baseUrl = http://localhost:4001/api/v1
@token = <paste_jwt_here>

### Login (public)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@sotrafer.cg",
  "password": "ChangeMe123!"
}

### Create user (ADMIN)
POST {{baseUrl}}/auth/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "ops@timegate.local",
  "password": "ChangeMe123!",
  "role": "MANAGER"
}

### List countries (lecture : tout utilisateur authentifié)
GET {{baseUrl}}/countries?page=1&limit=50
Authorization: Bearer {{token}}

### Create country (SUPER_ADMIN)
POST {{baseUrl}}/countries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "République du Congo",
  "isoCode": "CG",
  "phoneCode": "+242"
}

### List cities (filtre optionnel countryId)
GET {{baseUrl}}/cities?page=1&limit=100
Authorization: Bearer {{token}}

### Create city (SUPER_ADMIN)
POST {{baseUrl}}/cities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Brazzaville",
  "countryId": "<country_id>",
  "latitude": -4.2634,
  "longitude": 15.2429
}

### List branches
GET {{baseUrl}}/branches?page=1&limit=20
Authorization: Bearer {{token}}

### Create branch (ADMIN)
POST {{baseUrl}}/branches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "East Campus",
  "address": "55 River Rd",
  "timezone": "America/Chicago"
}

### List employees (filters: siteId, employeeId, from, to, search, isActive)
GET {{baseUrl}}/employees?siteId=&search=ada&page=1&limit=20
Authorization: Bearer {{token}}

### Create employee (ADMIN)
POST {{baseUrl}}/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "test.user@example.com",
  "branchId": "<branch_id>",
  "departmentId": "<department_id>",
  "designationId": "<designation_id>"
}

### Bulk import employees (ADMIN)
POST {{baseUrl}}/employees/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employees": [
    {
      "firstName": "Jean",
      "lastName": "Dupont",
      "branchId": "<branch_id>",
      "email": "jean.dupont@example.com"
    }
  ]
}

### Employee leave balances (ADMIN / MANAGER)
GET {{baseUrl}}/employees/<employee_id>/leave-balances?year=2026
Authorization: Bearer {{token}}

### List kiosks (filters: branchId, status, from, to)
GET {{baseUrl}}/kiosks?branchId=<branch_uuid>&status=ONLINE
Authorization: Bearer {{token}}

### Kiosk heartbeat (ADMIN + MANAGER)
PATCH {{baseUrl}}/kiosks/<kiosk_uuid>/heartbeat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "ONLINE"
}

### Record check-in (ADMIN + MANAGER)
POST {{baseUrl}}/attendance
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employeeId": "<employee_uuid>",
  "deviceId": "<device_uuid>",
  "type": "CHECK_IN",
  "confidence": 0.94
}

### List attendance (filters: siteId via device, employeeId, from, to)
GET {{baseUrl}}/attendance?siteId=<site_uuid>&employeeId=<employee_uuid>&from=2026-01-01T00:00:00.000Z&to=2026-12-31T23:59:59.999Z&page=1&limit=20
Authorization: Bearer {{token}}

### Face recognition logs (read-only, generated by kiosk verify)
GET {{baseUrl}}/face-recognition-logs?siteId=<branch_id>&from=2026-01-01T00:00:00.000Z&page=1&limit=20
Authorization: Bearer {{token}}

### Offline sync logs
GET {{baseUrl}}/face-recognition-logs/offline-sync?page=1&limit=20
Authorization: Bearer {{token}}

### Face enroll (ADMIN) — multipart photo
# curl -H "Authorization: Bearer TOKEN" -F "employeeId=<EMP_ID>" -F "photo=@./face.jpg" {{baseUrl}}/face/enroll

### Kiosk provisioning (ADMIN + MANAGER) => returns lifetime_token for kiosk app
POST {{baseUrl}}/auth/kiosk/provision
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "siteId": "<site_uuid>",
  "deviceName": "Kiosk Front Desk",
  "location": "Hall principal"
}

### List leave types
GET {{baseUrl}}/leave-types?page=1&limit=20
Authorization: Bearer {{token}}

### Create leave type (ADMIN)
POST {{baseUrl}}/leave-types
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Congé maladie",
  "isLwp": true,
  "isCarryForward": false,
  "maxDaysPerYear": 10
}

### Export attendance days CSV (ADMIN / MANAGER)
GET {{baseUrl}}/attendance/days/export?from=2026-01-01&to=2026-01-31
Authorization: Bearer {{token}}

### Employee login (public) — webapp `employee-web` sur http://localhost:3001
POST {{baseUrl}}/auth/employee/login
Content-Type: application/json

{
  "email": "patrick.mukendi@sotrafer.cg",
  "password": "ChangeMe123!"
}

### Employee portal — my leave balances
GET {{baseUrl}}/employee/leave-balances?year=2026
Authorization: Bearer <employee_token>

### Employee portal — leave types
GET {{baseUrl}}/employee/leave-types
Authorization: Bearer <employee_token>

### List holiday lists
GET {{baseUrl}}/holiday-lists?page=1&limit=20
Authorization: Bearer {{token}}

### Update employee contract (ADMIN)
PATCH {{baseUrl}}/employees/<employee_id>/contracts/<contract_id>
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "notes": "Renouvellement annuel",
  "renewalsCount": 1
}

### Delete employee contract (ADMIN)
DELETE {{baseUrl}}/employees/<employee_id>/contracts/<contract_id>
Authorization: Bearer {{token}}

### Kiosk verify (public endpoint, uses lifetime_token from provisioning)
POST {{baseUrl}}/auth/kiosk/verify
Authorization: Bearer <lifetime_token>
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

# Form fields:
# - photo: <image file>
