  status              TimeGateShiftSwapStatus @default(PENDING)
  reviewedByUserId    String?                 @map("reviewed_by") @db.VarChar(140)
  reviewedBy          User?                   @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?               @map("reviewed_at")
  reviewNote          String?                 @map("review_note") @db.VarChar(500)

  @@index([companyId, status])
  @@index([requesterEmployeeId])
  @@map("timegate_shift_swap_request")
}

model TimeGateAuditLog {
  id        String   @id @db.VarChar(140)
  userId    String?  @map("user") @db.VarChar(140)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String   @map("company") @db.VarChar(140)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(140)
  entity    String   @db.VarChar(140)
  entityId  String   @map("entity_id") @db.VarChar(140)
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("timegate_audit_log")
}

model PasswordResetToken {
  id              String    @id @db.VarChar(140)
  userId          String    @map("user") @db.VarChar(140)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash        String    @map("code_hash") @db.VarChar(255)
  resetTokenHash  String    @unique @map("reset_token_hash") @db.VarChar(255)
  codeExpiresAt   DateTime  @map("code_expires_at")
  tokenExpiresAt  DateTime  @map("token_expires_at")
  attempts        Int       @default(0)
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("creation")
  updatedAt       DateTime  @updatedAt @map("modified")

  @@index([userId, codeExpiresAt])
  @@map("tabPasswordResetToken")
}
