// Time Gate 1.2.0 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — Frappe / HRMS
// ---------------------------------------------------------------------------

enum DocStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum CheckinLogType {
  IN
  OUT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  ON_HOLIDAY
  WORK_FROM_HOME
}

enum PayrollEntryStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum KioskStatus {
  ONLINE
  OFFLINE
}

enum LeaveApplicationStatus {
  OPEN
  APPROVED
  REJECTED
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PaymentEntryType {
  PAY
  RECEIVE
  INTERNAL_TRANSFER
}

// ---------------------------------------------------------------------------
// Enums — TimeGate platform
// ---------------------------------------------------------------------------

enum TimeGateUserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TimeGateAttendanceEventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum TimeGateAttendanceEventSource {
  KIOSK_ONLINE
  KIOSK_OFFLINE_SYNC
  MANUAL
}

enum TimeGateAttendanceEventStatus {
  ACCEPTED
  REJECTED
  REVIEW_REQUIRED
}

enum TimeGateAttendanceAuthMethod {
  FACE
  PIN
  NFC
  QR
}

enum TimeGateTimesheetDayStatus {
  OPEN
  CLOSED
  REVIEW_REQUIRED
}

enum TimeGateSalaryStatus {
  PENDING
  PAID
}

enum TimeGatePayrollRunStatus {
  DRAFT
  LOCKED
  PAID
}

enum TimeGateShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeGateNotificationType {
  PUNCH_CHECK_IN
  PUNCH_CHECK_OUT
  PUNCH_BREAK
  PUNCH_REVIEW_REQUIRED
  PUNCH_LATE
  ABSENCE_AUTO
  UNCLOSED_CHECK_IN
  UNCLOSED_CHECK_IN_REMINDER
}

enum TimeGateDevicePlatform {
  IOS
  ANDROID
  WEB
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ---------------------------------------------------------------------------
// Tenant & organisation
// ---------------------------------------------------------------------------

model Company {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  ownerId   String?   @map("owner") @db.VarChar(140)
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  name     String? @map("company_name") @db.VarChar(140)
  sku      String? @unique @db.VarChar(140)
  abbr     String? @db.VarChar(140)
  timeZone String? @map("time_zone") @db.VarChar(140)
  logoUrl  String? @map("logo_url") @db.VarChar(500)
  phone    String? @db.VarChar(50)
  email    String? @db.VarChar(140)
  website  String? @db.VarChar(500)
  address  String? @db.VarChar(500)

  defaultPayrollPayableAccountId String? @map("default_payroll_payable_account") @db.VarChar(140)
  defaultPayrollPayableAccount   Account? @relation("CompanyPayrollPayableAccount", fields: [defaultPayrollPayableAccountId], references: [id], onDelete: SetNull)

  branches    Branch[]
  accounts    Account[]
  salaryComponents     SalaryComponent[]
  salaryStructures     SalaryStructure[]
  salaryStructureAssignments SalaryStructureAssignment[]
  payrollEntries       PayrollEntry[]
  paymentEntries       PaymentEntry[]
  departments Department[]
  employees   Employee[]
  kiosks      TimeGateKiosk[]
  shiftTypes  ShiftType[]
  users       User[]

  timeGateSubscriptions    TimeGateSubscription[]
  timeGateActivationKeys   TimeGateActivationKey[]
  timeGateSystemSettings   TimeGateSystemSettings?
  timeGateAuditLogs        TimeGateAuditLog[]
  timeGateAttendanceEvents TimeGateAttendanceEvent[]
  holidayLists             HolidayList[]
  leaveTypes               LeaveType[]
  timeGateTimesheetDays    TimeGateTimesheetDay[]
  timeGateLateRecords      TimeGateLateRecord[]
  timeGateAbsenceRecords   TimeGateAbsenceRecord[]
  timeGateSalaryRecords    TimeGateSalaryRecord[]
  timeGatePayrollRuns      TimeGatePayrollRun[]
  timeGateEmployeeContracts TimeGateEmployeeContract[]
  designations              Designation[]
  shiftSwapRequests         TimeGateShiftSwapRequest[]
  timeGateNotifications     TimeGateNotification[]

  @@map("tabCompany")
}

model Country {
  id        String   @id @db.VarChar(140)
  createdAt DateTime @default(now()) @map("creation")
  updatedAt DateTime @updatedAt @map("modified")

  name      String  @db.VarChar(140)
  isoCode   String  @unique @map("iso_code") @db.VarChar(10)
  phoneCode String? @map("phone_code") @db.VarChar(20)

  cities    City[]
  branches  Branch[]
  employees Employee[]

  @@map("tabCountry")
}

model City {
  id        String   @id @db.VarChar(140)
  createdAt DateTime @default(now()) @map("creation")
  updatedAt DateTime @updatedAt @map("modified")

  name      String  @db.VarChar(140)
  countryId String  @map("country") @db.VarChar(140)
  country   Country @relation(fields: [countryId], references: [id])
  latitude  Float?
  longitude Float?

  branches  Branch[]
  employees Employee[]

  @@unique([countryId, name])
  @@map("tabCity")
}

model Branch {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  branchName String  @map("branch") @db.VarChar(140)
  companyId  String  @map("company") @db.VarChar(140)
  company    Company @relation(fields: [companyId], references: [id])

  address  String? @db.Text
  timeZone String  @default("UTC") @map("time_zone") @db.VarChar(140)

  branchCode     String?  @map("branch_code") @db.VarChar(40)
  cityId         String?  @map("city") @db.VarChar(140)
  city           City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId      String?  @map("country") @db.VarChar(140)
  country        Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  latitude       Decimal? @db.Decimal(21, 7)
  longitude      Decimal? @db.Decimal(21, 7)
  checkinRadius  Int?     @map("checkin_radius")
  phone          String?  @db.VarChar(40)
  email          String?  @db.VarChar(140)
  isHeadOffice   Boolean  @default(false) @map("is_head_office")
  isActive       Boolean  @default(true) @map("is_active")

  employees      Employee[]
  shiftLocations ShiftLocation[]
  shiftTypes     ShiftType[]
  kiosk          TimeGateKiosk?
  faceLogs       FaceRecognitionLog[]
  userBranches   TimeGateUserBranch[]
  timeGateAttendanceEvents TimeGateAttendanceEvent[]

  @@map("tabBranch")
}

model Department {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  departmentName String  @map("department_name") @db.VarChar(140)
  companyId      String  @map("company") @db.VarChar(140)
  company        Company @relation(fields: [companyId], references: [id])

  code               String?      @db.VarChar(40)
  description        String?      @db.Text
  parentDepartmentId String?      @map("parent_department") @db.VarChar(140)
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  employees Employee[]

  @@map("tabDepartment")
}

model Designation {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  designationName String  @map("designation_name") @db.VarChar(140)
  companyId       String  @map("company") @db.VarChar(140)
  company         Company @relation(fields: [companyId], references: [id])

  description String? @db.Text
  grade       String? @db.VarChar(80)

  employees Employee[]

  @@unique([companyId, designationName])
  @@map("tabDesignation")
}

model EmploymentType {
  id               String @id @db.VarChar(140)
  employeeTypeName String @map("employee_type_name") @db.VarChar(140)

  employees Employee[]

  @@map("tabEmployment Type")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

model Employee {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  ownerId   String?   @map("owner") @db.VarChar(140)
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  employeeName  String         @map("employee_name") @db.VarChar(140)
  firstName     String?        @map("first_name") @db.VarChar(140)
  lastName      String?        @map("last_name") @db.VarChar(140)
  status        EmployeeStatus @default(ACTIVE)
  gender        String?        @db.VarChar(140)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  dateOfJoining DateTime?      @map("date_of_joining") @db.Date
  nationality   String?        @db.VarChar(140)
  maritalStatus String?        @map("marital_status") @db.VarChar(80)

  addressLine1          String? @map("address_line1") @db.VarChar(255)
  addressLine2          String? @map("address_line2") @db.VarChar(255)
  cityId                String? @map("city") @db.VarChar(140)
  city                  City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId             String? @map("country") @db.VarChar(140)
  country               Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  province              String? @db.VarChar(140)
  postalCode            String? @map("postal_code") @db.VarChar(40)
  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(140)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(40)
  nationalIdNumber      String? @map("national_id_number") @db.VarChar(80)
  passportNumber        String? @map("passport_number") @db.VarChar(80)

  companyId        String  @map("company") @db.VarChar(140)
  company          Company @relation(fields: [companyId], references: [id])
  branchId         String? @map("branch") @db.VarChar(140)
  branch           Branch? @relation(fields: [branchId], references: [id])
  departmentId     String? @map("department") @db.VarChar(140)
  department       Department? @relation(fields: [departmentId], references: [id])
  designationId    String? @map("designation") @db.VarChar(140)
  designation      Designation? @relation(fields: [designationId], references: [id])
  employmentTypeId String? @map("employment_type") @db.VarChar(140)
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  userId           String? @unique @map("user_id") @db.VarChar(140)
  user             User?   @relation(fields: [userId], references: [id])
  defaultShiftId   String? @map("default_shift") @db.VarChar(140)
  defaultShift     ShiftType? @relation(fields: [defaultShiftId], references: [id])
  holidayListId    String? @map("holiday_list") @db.VarChar(140)
  holidayList      HolidayList? @relation(fields: [holidayListId], references: [id], onDelete: SetNull)

  cellNumber     String? @map("cell_number") @db.VarChar(140)
  personalEmail  String? @map("personal_email") @db.VarChar(140)
  salaryCurrency String? @map("salary_currency") @db.VarChar(140)
  ctc            Decimal? @db.Decimal(21, 9)

  faceEnrollmentPhoto String?   @map("face_enrollment_photo") @db.Text
  faceEnrolledAt      DateTime? @map("face_enrolled_at")
  faceEmbedding       Json?     @map("face_embedding")
  kioskPinHash        String?   @map("kiosk_pin_hash") @db.VarChar(255)
  nfcBadgeUid         String?   @map("nfc_badge_uid") @db.VarChar(64)
  qrPunchTokenHash    String?   @map("qr_punch_token_hash") @db.VarChar(64)
  qrPunchTokenIssuedAt DateTime? @map("qr_punch_token_issued_at")

  checkins                 EmployeeCheckin[]
  attendances              Attendance[]
  faceLogs                 FaceRecognitionLog[]
  leaveApplications        LeaveApplication[]
  leaveAllocations         LeaveAllocation[]
  shiftAssignments         ShiftAssignment[]
  timesheets               Timesheet[]
  salarySlips              SalarySlip[]
  timeGateAttendanceEvents TimeGateAttendanceEvent[]
  timeGateTimesheetDays    TimeGateTimesheetDay[]
  timeGateLateRecords      TimeGateLateRecord[]
  timeGateAbsenceRecords   TimeGateAbsenceRecord[]
  timeGateSalaryRecords    TimeGateSalaryRecord[]
  timeGatePayrollLines     TimeGatePayrollLine[]
  timeGateEmployeeContracts TimeGateEmployeeContract[]
  salaryStructureAssignments SalaryStructureAssignment[]
  shiftSwapRequestsRequested TimeGateShiftSwapRequest[] @relation("ShiftSwapRequester")
  shiftSwapRequestsTarget    TimeGateShiftSwapRequest[] @relation("ShiftSwapTarget")

  @@unique([companyId, nfcBadgeUid])
  @@map("tabEmployee")
}

// ---------------------------------------------------------------------------
// Kiosk & attendance (Time Gate core)
// ---------------------------------------------------------------------------

model TimeGateKiosk {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  kioskName       String      @unique @map("kiosk_name") @db.VarChar(140)
  companyId       String      @map("company") @db.VarChar(140)
  company         Company     @relation(fields: [companyId], references: [id])
  branchId        String      @unique @map("branch") @db.VarChar(140)
  branch          Branch      @relation(fields: [branchId], references: [id])
  shiftLocationId String?     @map("shift_location") @db.VarChar(140)
  shiftLocation   ShiftLocation? @relation(fields: [shiftLocationId], references: [id])
  status          KioskStatus @default(OFFLINE)
  isActive        Boolean     @default(true) @map("is_active")
  lastSeenAt      DateTime?   @map("last_seen_at")
  deviceApiKey    String?     @unique @map("device_api_key") @db.VarChar(140)
  deviceToken     String?     @map("device_token") @db.Text
  faceEnabled     Boolean     @default(true) @map("face_enabled")
  nfcEnabled      Boolean     @default(false) @map("nfc_enabled")
  qrEnabled       Boolean     @default(false) @map("qr_enabled")

  faceLogs                 FaceRecognitionLog[]
  timeGateAttendanceEvents TimeGateAttendanceEvent[]

  @@map("tabTimeGate Kiosk")
}

model FaceRecognitionLog {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  kioskId           String  @map("kiosk") @db.VarChar(140)
  kiosk             TimeGateKiosk @relation(fields: [kioskId], references: [id])
  branchId          String? @map("branch") @db.VarChar(140)
  branch            Branch? @relation(fields: [branchId], references: [id])
  companyId         String? @map("company") @db.VarChar(140)
  employeeId        String? @map("employee") @db.VarChar(140)
  employee          Employee? @relation(fields: [employeeId], references: [id])
  employeeName      String? @map("employee_name") @db.VarChar(140)
  success           Boolean @default(false)
  confidence        Decimal? @db.Decimal(21, 9)
  message           String? @db.Text
  employeeCheckinId String? @unique @map("employee_checkin") @db.VarChar(140)
  employeeCheckin   EmployeeCheckin? @relation(fields: [employeeCheckinId], references: [id])
  photo             String? @db.Text
  idempotencyKey    String? @map("idempotency_key") @db.VarChar(140)
  isOfflineSync     Boolean @default(false) @map("is_offline_sync")
  capturedAt        DateTime? @map("captured_at")

  @@index([idempotencyKey, kioskId])
  @@map("tabFace Recognition Log")
}

model EmployeeCheckin {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  employeeId   String         @map("employee") @db.VarChar(140)
  employee     Employee       @relation(fields: [employeeId], references: [id])
  employeeName String?        @map("employee_name") @db.VarChar(140)
  logType      CheckinLogType @map("log_type")
  time         DateTime
  deviceId     String?        @map("device_id") @db.VarChar(140)
  shiftId      String?        @map("shift") @db.VarChar(140)
  shift        ShiftType?     @relation(fields: [shiftId], references: [id])
  attendanceId String?        @map("attendance") @db.VarChar(140)
  attendance   Attendance?    @relation(fields: [attendanceId], references: [id])
  latitude     Decimal?       @db.Decimal(21, 7)
  longitude    Decimal?       @db.Decimal(21, 7)
  offshift     Boolean        @default(false)

  faceLog FaceRecognitionLog?

  @@index([employeeId, time])
  @@map("tabEmployee Checkin")
}

model Attendance {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  employeeId     String           @map("employee") @db.VarChar(140)
  employee       Employee         @relation(fields: [employeeId], references: [id])
  employeeName   String?          @map("employee_name") @db.VarChar(140)
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  companyId      String?          @map("company") @db.VarChar(140)
  shiftId        String?          @map("shift") @db.VarChar(140)
  shift          ShiftType?       @relation(fields: [shiftId], references: [id])
  leaveTypeId    String?          @map("leave_type") @db.VarChar(140)
  leaveType      LeaveType?       @relation(fields: [leaveTypeId], references: [id])

  checkins EmployeeCheckin[]

  @@unique([employeeId, attendanceDate])
  @@index([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
  @@map("tabAttendance")
}

model ShiftType {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  shiftName        String  @map("shift_type_name") @db.VarChar(140)
  companyId        String? @map("company") @db.VarChar(140)
  company          Company? @relation(fields: [companyId], references: [id])
  branchId         String? @map("branch") @db.VarChar(140)
  branch           Branch? @relation(fields: [branchId], references: [id])
  startTime        DateTime? @map("start_time") @db.Time
  endTime          DateTime? @map("end_time") @db.Time
  lateGraceMinutes Int     @default(5) @map("late_grace_minutes")
  checkInWindowStart  DateTime? @map("check_in_window_start") @db.Time
  checkInWindowEnd    DateTime? @map("check_in_window_end") @db.Time
  checkOutWindowStart DateTime? @map("check_out_window_start") @db.Time
  checkOutWindowEnd   DateTime? @map("check_out_window_end") @db.Time
  breakWindowStart    DateTime? @map("break_window_start") @db.Time
  breakWindowEnd      DateTime? @map("break_window_end") @db.Time
  breakDurationMinutes Int?    @default(60) @map("break_duration_minutes")

  weekDays    ShiftTypeWeekDay[]
  employees   Employee[]
  assignments ShiftAssignment[]
  checkins    EmployeeCheckin[]
  attendances Attendance[]
  companyDefaultShifts TimeGateSystemSettings[]

  @@index([companyId])
  @@index([branchId])
  @@map("tabShift Type")
}

model ShiftTypeWeekDay {
  id        String   @id @db.VarChar(140)
  createdAt DateTime @default(now()) @map("creation")
  idx       Int      @default(0)

  shiftTypeId String    @map("parent") @db.VarChar(140)
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  day         WeekDay
  startTime   String  @map("start_time") @db.VarChar(10)
  endTime     String  @map("end_time") @db.VarChar(10)

  @@unique([shiftTypeId, day])
  @@map("timegate_shift_type_week_day")
}

model ShiftLocation {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  locationName    String  @unique @map("location_name") @db.VarChar(140)
  checkinRadius   Int?    @map("checkin_radius")
  latitude        Float?
  longitude       Float?
  branchId        String? @map("branch") @db.VarChar(140)
  branch          Branch? @relation(fields: [branchId], references: [id])
  isKioskLocation Boolean @default(false) @map("is_kiosk_location")

  kiosks      TimeGateKiosk[]
  assignments ShiftAssignment[]

  @@map("tabShift Location")
}

model ShiftAssignment {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  employeeId      String        @map("employee") @db.VarChar(140)
  employee        Employee      @relation(fields: [employeeId], references: [id])
  shiftTypeId     String        @map("shift_type") @db.VarChar(140)
  shiftType       ShiftType     @relation(fields: [shiftTypeId], references: [id])
  shiftLocationId String?       @map("shift_location") @db.VarChar(140)
  shiftLocation   ShiftLocation? @relation(fields: [shiftLocationId], references: [id])
  companyId       String?       @map("company") @db.VarChar(140)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date

  shiftSwapRequests TimeGateShiftSwapRequest[]

  @@map("tabShift Assignment")
}

model HolidayList {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  holidayListName String  @map("holiday_list_name") @db.VarChar(140)
  companyId       String? @unique @map("company") @db.VarChar(140)
  company         Company? @relation(fields: [companyId], references: [id])
  holidays        Holiday[]
  employees       Employee[]

  @@map("tabHoliday List")
}

model Holiday {
  id        String   @id @db.VarChar(140)
  createdAt DateTime @default(now()) @map("creation")
  idx       Int      @default(0)

  parentId    String      @map("parent") @db.VarChar(140)
  holidayList HolidayList @relation(fields: [parentId], references: [id], onDelete: Cascade)
  holidayDate DateTime?   @map("holiday_date") @db.Date
  description String?     @db.VarChar(140)

  @@map("tabHoliday")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  leaveTypeName  String  @map("leave_type_name") @db.VarChar(140)
  isLwp          Boolean @default(false) @map("is_lwp")
  isCarryForward Boolean @default(false) @map("is_carry_forward")
  maxDaysPerYear Int?    @map("max_days_per_year")
  companyId      String? @map("company") @db.VarChar(140)
  company        Company? @relation(fields: [companyId], references: [id])

  applications LeaveApplication[]
  attendances  Attendance[]
  allocations  LeaveAllocation[]

  @@unique([companyId, leaveTypeName])
  @@map("tabLeave Type")
}

model LeaveApplication {
  id        String    @id @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("creation")
  updatedAt DateTime  @updatedAt @map("modified")
  docStatus DocStatus @default(DRAFT) @map("docstatus")

  employeeId   String                 @map("employee") @db.VarChar(140)
  employee     Employee               @relation(fields: [employeeId], references: [id])
  leaveTypeId  String                 @map("leave_type") @db.VarChar(140)
  leaveType    LeaveType              @relation(fields: [leaveTypeId], references: [id])
  companyId    String?                @map("company") @db.VarChar(140)
  fromDate     DateTime?              @map("from_date") @db.Date
  toDate       DateTime?              @map("to_date") @db.Date
  status       LeaveApplicationStatus @default(OPEN)
  reason       String?                @db.VarChar(500)

  @@map("tabLeave Application")
}

