# Copy to .env for local development
DATABASE_URL=postgresql://user:password@localhost:5432/timegate
# Postgres dédié aux tests API (jamais AlwaysData / pilote)
E2E_DATABASE_URL=postgresql://postgres:postpass@localhost:5432/timegate_db
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
# Opaque refresh token lifetime (dashboard/console session prolongation)
JWT_REFRESH_EXPIRES_IN=30d
PORT=4001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Face engine (optional)
FACE_ENGINE_PYTHON_BIN=python
FACE_ENGINE_TIMEOUT_MS=45000
FACE_VERIFY_THRESHOLD=0.75
