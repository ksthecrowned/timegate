# Copy to .env for local development
DATABASE_URL=postgresql://user:password@localhost:5432/timegate
# Postgres dédié aux tests API (jamais AlwaysData / pilote)
E2E_DATABASE_URL=postgresql://postgres:postpass@localhost:5432/timegate_db
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
# Opaque refresh token lifetime (dashboard/console session prolongation)
JWT_REFRESH_EXPIRES_IN=30d
PORT=4001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Face engine (optional)
# Local Windows: run scripts/setup-face-venv.sh then point to .venv/Scripts/python.exe
# Linux / Render: build creates api/.venv — use .venv/bin/python (or leave unset for auto-detect)
FACE_ENGINE_PYTHON_BIN=.venv/bin/python
FACE_ENGINE_PERSISTENT=true
FACE_ENGINE_WARMUP=true
FACE_ENGINE_PROBE_TIMEOUT_MS=45000
FACE_ENGINE_BOOT_TIMEOUT_MS=90000
FACE_ENGINE_TIMEOUT_MS=60000
FACE_VERIFY_THRESHOLD=0.75
