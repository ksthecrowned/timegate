{
  "expo": {
    "name": "TMG Employee",
    "slug": "timegate-employee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "timegate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.timegate.employee",
      "infoPlist": {
        "NSCameraUsageDescription": "Autorisez TimeGate à utiliser la caméra pour scanner le QR de pointage de la borne.",
        "CFBundleDisplayName": "TimeGate"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.timegate.employee",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseNotificationManifestFix",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d9488",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0d9488"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez TimeGate à utiliser la caméra pour scanner le QR de pointage de la borne.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-quick-actions",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://timegate.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "70532fa0-5a00-40e1-8ce1-88ef3a231aed"
      }
    },
    "owner": "kysr_styve"
  }
}
