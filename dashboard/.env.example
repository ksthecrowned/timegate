# Dashboard TimeGate — variables pour Vercel (Project Settings → Environment Variables)
#
# Déploiement Vercel : Root Directory = dashboard

# API NestJS (obligatoire) — ex. https://api.example.com/api/v1
NEXT_PUBLIC_TIMEGATE_API_URL=

# NextAuth / Auth.js (obligatoire) — openssl rand -base64 32
AUTH_SECRET=
# NEXTAUTH_SECRET=

# URL publique du dashboard (recommandé en prod) — ex. https://app.example.com
# AUTH_URL=

# Lien vers la console super-admin (optionnel)
# NEXT_PUBLIC_CONSOLE_URL=https://console.example.com

# Web Push Firebase (optionnel — notifications navigateur)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Session (optionnel — défaut aligné JWT API 8h)
# AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
# AUTH_SESSION_MAX_AGE_SECONDS=28800
# AUTH_REFRESH_ENABLED=false
