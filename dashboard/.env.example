# ─── NextAuth (obligatoire) ───────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─── TimeGate API ─────────────────────────────────────────────────────────────
# Base URL complète incluant /api/v1
NEXT_PUBLIC_TIMEGATE_API_URL=http://localhost:4001/api/v1

# ─── Session / JWT (aligné sur api JWT_EXPIRES_IN, défaut 8h) ────────────────
# Durée du Bearer token TMGT. Doit correspondre à JWT_EXPIRES_IN dans api/.env.
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800

# Session NextAuth (optionnel) — par défaut = AUTH_ACCESS_TOKEN_TTL_SECONDS
# AUTH_SESSION_MAX_AGE_SECONDS=28800

# Marge avant expiration (informatif tant que refresh désactivé)
AUTH_REFRESH_BUFFER_SECONDS=300

# false : pas de POST /auth/refresh côté TMGT → reconnexion à l'expiration du JWT
# true  : inutile aujourd'hui (provoque une déconnexion forcée à l'expiration)
AUTH_REFRESH_ENABLED=false
